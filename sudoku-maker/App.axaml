<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="sudoku_maker.App"
             RequestedThemeVariant="Light">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
    <Application.Resources>
        <SolidColorBrush x:Key="BgPage">#FAF7F2</SolidColorBrush>
        <SolidColorBrush x:Key="BgCard">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="TextPrimary">#2C2C2A</SolidColorBrush>
        <SolidColorBrush x:Key="TextSecondary">#5F5E5A</SolidColorBrush>
        <SolidColorBrush x:Key="BorderColor">#D3D1C7</SolidColorBrush>
        <SolidColorBrush x:Key="AccentColor">#0F6E56</SolidColorBrush>
        <SolidColorBrush x:Key="ErrorBg">#F5C4B3</SolidColorBrush>
        <FontFamily x:Key="AppFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
        <StaticResource x:Key="ButtonBackground" ResourceKey="BgCard"/>
        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="BgCard"/>
        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="BgCard"/>
        <StaticResource x:Key="ButtonForeground" ResourceKey="TextPrimary"/>
        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextPrimary"/>
        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextPrimary"/>
        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="BorderColor"/>
        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="AccentColor"/>
        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="AccentColor"/>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window, UserControl">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>
        <Style Selector="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
    </Application.Styles>
</Application>