<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:sudoku_maker.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="700"
             x:Class="sudoku_maker.Views.SudokuView"
             x:DataType="vm:SudokuViewModel"
             Focusable="True"
             KeyDown="SudokuView_KeyDown">

    <UserControl.Styles>

        <Style Selector="Border.cell-frame">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <Style Selector="Border.cell-given">
            <Setter Property="Background" Value="{DynamicResource BgPage}"/>
        </Style>

        <Style Selector="Border.cell-error">
            <Setter Property="Background" Value="{DynamicResource ErrorBg}"/>
        </Style>

        <Style Selector="Border.cell-conflict">
            <Setter Property="Background" Value="#F5D9A8"/>
        </Style>

        <Style Selector="Border.cell-selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="TextBlock.cell-value">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.cell-value-given">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="TextBlock.note-digit">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.tool-active">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

    </UserControl.Styles>
    <Grid RowDefinitions="60,*" Background="{DynamicResource BgPage}">
        <Border Grid.Row="0" Background="{DynamicResource BgCard}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10" Spacing="8">
                <Button Width="40" Height="40" Padding="0" Click="Back_Button_Click">
                    <Image Source="{SvgImage /Assets/Images/Back_Button.svg}"/>
                </Button>
                <Button Width="40" Height="40" Padding="0" Command="{Binding SaveGameCommand}">
                    <Image Source="{SvgImage /Assets/Images/Save_Button.svg}"/>
                </Button>
                <Button Width="40" Height="40" Padding="0" Command="{Binding OpenSavedGamesCommand}">
                    <Image Source="{SvgImage /Assets/Images/Import_Button.svg}"/>
                </Button>
                <Button Width="40" Height="40" Padding="0" Command="{Binding NewGameCommand}">
                    <Image Source="{SvgImage /Assets/Images/New_Button.svg}"/>
                </Button>

                <TextBlock Text="Sudoku Maker" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="18,0,40,0"/>

                <Image Source="{SvgImage /Assets/Images/Clock.svg}" Width="40" Height="40"/>

                <TextBlock Text="{Binding FormattedElaspedTime}" FontSize="18" VerticalAlignment="Center" Margin="24,0,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="20" ColumnDefinitions="*,220">
            <Border Grid.Column="0" Background="{DynamicResource BgPage}" CornerRadius="10" Padding="16">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource BorderColor}" Padding="8">
                    <Border Background="{DynamicResource BgCard}" Padding="6">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding Cells}" Width="504" Height="504">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="9" Columns="9"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SudokuCellViewModel">
                                        <Border Classes="cell-frame" Width="56" Height="56"
                                                Classes.cell-error="{Binding HasError}"
                                                Classes.cell-conflict="{Binding HasConflict}"
                                                Classes.cell-given="{Binding IsGiven}"
                                                Classes.cell-selected="{Binding IsSelected}"
                                                PointerPressed="Cell_PointerPressed">
                                            <Grid>
                                                <TextBlock Text="{Binding Value}"
                                                           Classes="cell-value"
                                                           Classes.cell-value-given="{Binding IsGiven}"
                                                           IsVisible="{Binding !ShowNotes}"/>

                                                <ItemsControl ItemsSource="{Binding Notes}" IsVisible="{Binding ShowNotes}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Rows="3" Columns="3"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:NoteDigitViewModel">
                                                            <TextBlock Text="{Binding DisplayText}" Classes="note-digit"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Canvas Width="504" Height="504" IsHitTestVisible="False">
                                <!-- dikey ince çizgiler -->
                                <Rectangle Canvas.Left="55.5" Canvas.Top="0" Width="1" Height="504" Fill="{DynamicResource TextPrimary}"/>
                                <Rectangle Canvas.Left="111.5" Canvas.Top="0" Width="1" Height="504" Fill="{DynamicResource TextPrimary}"/>
                                <Rectangle Canvas.Left="223.5" Canvas.Top="0" Width="1" Height="504" Fill="{DynamicResource TextPrimary}"/>
                                <Rectangle Canvas.Left="279.5" Canvas.Top="0" Width="1" Height="504" Fill="{DynamicResource TextPrimary}"/>
                                <Rectangle Canvas.Left="391.5" Canvas.Top="0" Width="1" Height="504" Fill="{DynamicResource TextPrimary}"/>
                                <Rectangle Canvas.Left="447.5" Canvas.Top="0" Width="1" Height="504" Fill="{DynamicResource TextPrimary}"/>

                                <!-- yatay ince çizgiler -->
                                <Rectangle Canvas.Left="0" Canvas.Top="55.5" Width="504" Height="1" Fill="{DynamicResource TextPrimary}"/>
                                <Rectangle Canvas.Left="0" Canvas.Top="111.5" Width="504" Height="1" Fill="{DynamicResource TextPrimary}"/>
                                <Rectangle Canvas.Left="0" Canvas.Top="223.5" Width="504" Height="1" Fill="{DynamicResource TextPrimary}"/>
                                <Rectangle Canvas.Left="0" Canvas.Top="279.5" Width="504" Height="1" Fill="{DynamicResource TextPrimary}"/>
                                <Rectangle Canvas.Left="0" Canvas.Top="391.5" Width="504" Height="1" Fill="{DynamicResource TextPrimary}"/>
                                <Rectangle Canvas.Left="0" Canvas.Top="447.5" Width="504" Height="1" Fill="{DynamicResource TextPrimary}"/>

                                <!-- kalın blok çizgileri -->
                                <Rectangle Canvas.Left="166.5" Canvas.Top="0" Width="3" Height="504" Fill="{DynamicResource TextPrimary}"/>
                                <Rectangle Canvas.Left="334.5" Canvas.Top="0" Width="3" Height="504" Fill="{DynamicResource TextPrimary}"/>
                                <Rectangle Canvas.Left="0" Canvas.Top="166.5" Width="504" Height="3" Fill="{DynamicResource TextPrimary}"/>
                                <Rectangle Canvas.Left="0" Canvas.Top="334.5" Width="504" Height="3" Fill="{DynamicResource TextPrimary}"/>

                                <!-- dış çerçeve -->
                                <Rectangle Canvas.Left="0" Canvas.Top="0" Width="504" Height="2" Fill="{DynamicResource TextPrimary}"/>
                                <Rectangle Canvas.Left="0" Canvas.Top="502" Width="504" Height="2" Fill="{DynamicResource TextPrimary}"/>
                                <Rectangle Canvas.Left="0" Canvas.Top="0" Width="2" Height="504" Fill="{DynamicResource TextPrimary}"/>
                                <Rectangle Canvas.Left="502" Canvas.Top="0" Width="2" Height="504" Fill="{DynamicResource TextPrimary}"/>
                            </Canvas>
                        </Grid>
                    </Border>
                </Border>
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="10">
                <Button Width="40" Height="40" Padding="0" Command="{Binding CheckCommand}">
                    <Image Source="{SvgImage /Assets/Images/Check_Button.svg}"/>
                </Button>
                <Button Width="40" Height="40" Padding="0" Command="{Binding HintCommand}">
                    <Image Source="{SvgImage /Assets/Images/Hint_Button.svg}"/>
                </Button>
                <Button Width="40" Height="40" Padding="0" Command="{Binding ResetCommand}">
                    <Image Source="{SvgImage /Assets/Images/Reset_Button.svg}"/>
                </Button>

                <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,6"/>

                <Button Content="Notes" HorizontalContentAlignment="Center"
                        Command="{Binding ToggleNoteModeCommand}"
                        Classes.tool-active="{Binding IsNoteMode}"/>
                <Button Content="Undo" HorizontalContentAlignment="Center"
                        Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"/>
                <Button Content="Redo" HorizontalContentAlignment="Center"
                        Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"/>
                <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,6"/>
                <Button Content="Export PDF" HorizontalContentAlignment="Center" Click="ExportPdf_Button_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>