<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:sudoku_maker.ViewModels"
             x:Class="sudoku_maker.Views.LeaderboardView"
             x:DataType="vm:LeaderboardViewModel">
    <Grid Background="{DynamicResource BgPage}" Margin="24">
        <Border CornerRadius="12" Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                Padding="20">
            <Grid RowDefinitions="Auto,Auto,*">

                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,16">
                    <Button Grid.Column="0" Content="Back" Click="Back_Button_Click"/>
                    <TextBlock Grid.Column="1" Text="Leaderboard" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <Button Content="Sort by Score" Command="{Binding SortByScoreOptionCommand}"/>
                    <Button Content="Sort by Time" Command="{Binding SortByTimeOptionCommand}"/>
                </StackPanel>

                <Grid Grid.Row="2" ColumnDefinitions="*,*,*">
                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                        <TextBlock Text="Easy" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding EasyEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LeaderboardEntryViewModel">
                                    <TextBlock Text="{Binding DisplayText}" FontSize="13" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6" Margin="8,0">
                        <TextBlock Text="Medium" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding MediumEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LeaderboardEntryViewModel">
                                    <TextBlock Text="{Binding DisplayText}" FontSize="13" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="6" Margin="8,0,0,0">
                        <TextBlock Text="Hard" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding HardEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LeaderboardEntryViewModel">
                                    <TextBlock Text="{Binding DisplayText}" FontSize="13" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>