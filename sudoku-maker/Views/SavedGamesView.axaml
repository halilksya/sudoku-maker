<UserControl
    x:Class="sudoku_maker.Views.SavedGamesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:sudoku_maker.ViewModels"
    x:DataType="vm:SavedGameViewModel">

    <UserControl.Styles>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource BgPage}">
        <StackPanel Margin="20" Spacing="12" HorizontalAlignment="Center">
            <TextBlock Text="Saved Games" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>

            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1" CornerRadius="8" Width="360">
                <ListBox ItemsSource="{Binding SavedGames}" SelectedItem="{Binding SelectedSavedGame, Mode=TwoWay}"
                         Height="300" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SavedGameItemViewModel">
                            <TextBlock Text="{Binding DisplayText}" FontSize="16" Margin="8"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button Content="Open" Width="100" Command="{Binding OpenSelectedCommand}"/>
                <Button Content="Delete" Width="100" Command="{Binding DeleteSelectedCommand}"/>
                <Button Content="Cancel" Width="100" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>