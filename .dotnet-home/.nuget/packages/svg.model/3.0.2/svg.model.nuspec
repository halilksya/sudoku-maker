<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Svg.Model</id>
    <version>3.0.2</version>
    <authors>Wiesław Šoltés</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <projectUrl>https://github.com/wieslawsoltes/Svg.Skia</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/wieslawsoltes/Svg.Skia/master/icon/SvgToPng.png</iconUrl>
    <description>An SVG rendering object model library.</description>
    <copyright>Copyright © Wiesław Šoltés 2025</copyright>
    <tags>svg vector graphics rendering 2d graphics geometry shapes skiasharp skia model</tags>
    <repository type="git" url="https://github.com/wieslawsoltes/Svg.Skia" commit="c722c246b12da36e1731da3d7c7f5f3cc1cd28ef" />
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="ShimSkiaSharp" version="3.0.2" exclude="Build,Analyzers" />
        <dependency id="Svg.Custom" version="3.0.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0">
        <dependency id="ShimSkiaSharp" version="3.0.2" exclude="Build,Analyzers" />
        <dependency id="Svg.Custom" version="3.0.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="ShimSkiaSharp" version="3.0.2" exclude="Build,Analyzers" />
        <dependency id="Svg.Custom" version="3.0.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="ShimSkiaSharp" version="3.0.2" exclude="Build,Analyzers" />
        <dependency id="Svg.Custom" version="3.0.2" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>